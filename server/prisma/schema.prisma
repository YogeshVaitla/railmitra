// Main schema for the Train Seat Seeker app
// Using PostgreSQL for production/cloud deployment.
// For local dev with SQLite, change provider to "sqlite" and update DATABASE_URL in .env.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// SeatMaster: This is our static list of all trains, coaches, and seats.
// Basically the "blueprint" of every train we track.
model SeatMaster {
  id         Int        @id @default(autoincrement())
  trainNo    String
  coachId    String
  seatNo     Int
  seatType   String     // e.g. WINDOW, MIDDLE, AISLE, etc.
  coachType  String     // LHB, ICF, or UNKNOWN if we can't tell
  classType  String     // SL, 3A, 2A, 1A, CC, EC

  reports    SeatReport[]

  @@unique([trainNo, coachId, seatNo])
  @@index([trainNo])
  @@index([trainNo, coachId])
}

// SeatReport: These are the actual live updates from users on the train.
// "Is this seat empty right now?" "Yeah, I'm sitting here" or "Someone's luggage is here".
model SeatReport {
  id                 Int      @id @default(autoincrement())
  seatId             Int
  seat               SeatMaster @relation(fields: [seatId], references: [id])
  status             String   // EMPTY, OCCUPIED, or EXCHANGE_OFFER
  deviceId           String   // We hash this to keep people's hardware private
  gpsLat             Float?
  gpsLong            Float?
  verificationMethod String   // How did we verify this? GPS? PNR check? Peer confirmed?
  confidence         Float    @default(0.5) // How much we trust this specific report
  timestamp          DateTime @default(now())

  @@index([seatId, timestamp])
  @@index([deviceId])
}

// UserReputation: Keeps track of who's reliable. 
// If someone reports accurately, their trust score goes up.
model UserReputation {
  id              Int      @id @default(autoincrement())
  deviceId        String   @unique
  trustScore      Float    @default(0.5) // Ranges from 0 (liar) to 1 (perfect)
  totalReports    Int      @default(0)
  verifiedReports Int      @default(0)
  streakCount     Int      @default(0) // How many good reports in a row?
  lastReportAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([trustScore])
}

// ToiletStatus: Cleanliness and water levels in specific coaches.
model ToiletStatus {
  id               Int      @id @default(autoincrement())
  trainNo          String
  coachId          String
  toiletType       String   // WESTERN or INDIAN
  cleanlinessScore Float    @default(3.0) // 1 to 5 scale
  waterAvailable   Boolean  @default(true)
  queueLength      Int      @default(0) // Inferred from foot traffic/sensors
  reportedBy       String   // deviceId (hashed)
  timestamp        DateTime @default(now())

  @@index([trainNo, coachId])
}

// SwapRequest: For when someone wants to switch seats with a fellow passenger.
// "I have a middle berth, I want a lower berth"
model SwapRequest {
  id              Int      @id @default(autoincrement())
  trainNo         String
  userId          String   // deviceId (hashed)
  currentCoachId  String
  currentSeatNo   Int
  currentSeatType String   // Current berth type
  desiredSeatType String   // What the user is hoping to get
  status          String   @default("OPEN") // OPEN, MATCHED, ACCEPTED, COMPLETED, CANCELLED, EXPIRED, WITHDRAWN
  matchedWith     Int?     // Link to the other person's SwapRequest ID
  sessionId       Int?     // Links to SwapSession for multi-party swaps
  priorityScore   Float    @default(0.5)   // Computed from trust, wait time, reason
  reason          String?  // "elderly", "medical", "family", "preference"
  expiresAt       DateTime? // Auto-expire stale requests
  journeyDate     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events          SwapEvent[]
  session         SwapSession? @relation(fields: [sessionId], references: [id])

  @@index([trainNo, status])
  @@index([trainNo, desiredSeatType, status])
  @@index([trainNo, journeyDate, status])
  @@index([expiresAt])
}

// Immutable audit log — every state change is recorded here.
// This is the kind of thing acquirers love to see: full traceability.
model SwapEvent {
  id          Int      @id @default(autoincrement())
  swapId      Int
  swap        SwapRequest @relation(fields: [swapId], references: [id])
  eventType   String   // CREATED, MATCHED, ACCEPTED, REJECTED, CANCELLED, EXPIRED, COMPLETED, WITHDRAWN
  actorId     String   // Who triggered this (hashed device ID)
  metadata    String?  // JSON blob with extra context
  timestamp   DateTime @default(now())

  @@index([swapId, timestamp])
  @@index([eventType])
}

// Groups multi-party swaps into atomic transactions.
// A 3-way swap needs all 3 people to accept — this tracks that.
model SwapSession {
  id            Int      @id @default(autoincrement())
  type          String   // DIRECT, TRIANGULAR, CHAIN
  status        String   @default("PENDING") // PENDING, ACCEPTED, COMPLETED, FAILED
  participants  SwapRequest[]
  acceptedBy    String   @default("") // Comma-separated list of userIds who accepted
  totalRequired Int      @default(2)
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([status])
}
